  {
    "descriptor": {
      "description": "Execute all HTTP cases in a YAML or JSON assertion spec.",
      "effects": {
        "destructive": false,
        "effects": [
          "filesystem_read",
          "network_read",
          "network_write",
          "external_read",
          "external_write"
        ],
        "idempotent": false,
        "impact": "Reads a local spec and payload files, then sends every declared HTTP method, credential, and payload to declared URLs; cases may mutate external systems.",
        "open_world": true,
        "read_only": false,
        "reversibility": "unknown",
        "risk": "high"
      },
      "examples": [],
      "id": "http.run",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "fail_fast": {
            "default": false,
            "description": "Stop after the first failed case.",
            "type": "boolean"
          },
          "retry": {
            "default": 0,
            "description": "Additional attempts per case for transport failures, timeouts, response read failures, and HTTP 5xx.",
            "minimum": 0,
            "type": "integer"
          },
          "retry_delay_ms": {
            "default": 0,
            "description": "Fixed delay in milliseconds between retry attempts.",
            "minimum": 0,
            "type": "integer"
          },
          "spec_path": {
            "description": "YAML or JSON spec path resolved against the execution cwd.",
            "minLength": 1,
            "type": "string"
          },
          "vars": {
            "description": "Template variables encoded as KEY=VALUE.",
            "items": {
              "pattern": "^[^=]+=.*$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "spec_path"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "cases": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "duration_ms": {
                  "minimum": 0,
                  "type": "integer"
                },
                "failures": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "name": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "status": {
                  "maximum": 599,
                  "minimum": 100,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "passed",
                "status",
                "duration_ms",
                "failures"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "command": {
            "const": "http.assert",
            "type": "string"
          },
          "fail_fast": {
            "type": "boolean"
          },
          "spec_path": {
            "type": "string"
          },
          "summary": {
            "additionalProperties": false,
            "properties": {
              "duration_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "failed": {
                "minimum": 0,
                "type": "integer"
              },
              "passed": {
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "total",
              "passed",
              "failed",
              "duration_ms"
            ],
            "type": "object"
          }
        },
        "required": [
          "command",
          "spec_path",
          "fail_fast",
          "summary",
          "cases"
        ],
        "type": "object"
      },
      "secret_slots": [],
      "title": "Run HTTP assertion alias"
    },
