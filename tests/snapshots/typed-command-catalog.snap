[
  {
    "descriptor": {
      "description": "Return the AI-oriented manual for all enabled domains or one selected domain.",
      "effects": {
        "destructive": false,
        "effects": [
          "configuration_read"
        ],
        "idempotent": true,
        "impact": "Reads the in-memory command registry and returns documentation only.",
        "open_world": false,
        "read_only": true,
        "reversibility": "yes",
        "risk": "low"
      },
      "examples": [],
      "id": "ai.info",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "description": "Optional domain filter.",
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "ai.info",
            "type": "string"
          },
          "domain_filter": {
            "type": [
              "string",
              "null"
            ]
          },
          "global_options": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "flag": {
                  "type": "string"
                }
              },
              "required": [
                "flag",
                "description"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "host_commands": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "examples": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "command": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "description",
                      "command"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "name": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "usage": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "summary",
                "usage",
                "examples"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "plugin_count": {
            "minimum": 0,
            "type": "integer"
          },
          "plugins": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "commands": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "examples": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "argv": {
                              "items": {
                                "type": "string"
                              },
                              "type": "array"
                            },
                            "description": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "description",
                            "argv"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "name": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "usage": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "summary",
                      "usage",
                      "examples"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "description": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "notes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "plugin_name": {
                  "type": "string"
                }
              },
              "required": [
                "plugin_name",
                "domain",
                "description",
                "commands",
                "notes"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
