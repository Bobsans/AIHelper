            "type": "string"
          },
          "store_path": {
            "type": "string"
          },
          "task_command": {
            "type": "string"
          },
          "updated_unix_seconds": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "command",
          "name",
          "task_command",
          "store_path",
          "updated_unix_seconds"
        ],
        "type": "object"
      },
      "secret_slots": [],
      "title": "Save task"
    },
    "domain": "task",
    "plugin": "builtin-task"
  }
