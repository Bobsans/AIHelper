          "domain_filter",
          "global_options",
          "host_commands",
          "plugin_count",
          "plugins"
        ],
        "type": "object"
      },
      "secret_slots": [],
      "title": "AIHelper agent manual"
    },
    "domain": "ai",
    "plugin": "host-ai"
  },
  {
    "descriptor": {
      "description": "Return changed paths from the Git working tree rooted at the execution cwd.",
      "effects": {
        "destructive": false,
        "effects": [
          "filesystem_read",
          "process_spawn"
        ],
        "idempotent": true,
        "impact": "Runs read-only Git repository checks and reads working-tree status.",
        "open_world": false,
        "read_only": true,
        "reversibility": "yes",
        "risk": "low"
      },
      "examples": [],
      "id": "ctx.changed",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "changed_count": {
            "minimum": 0,
            "type": "integer"
          },
          "command": {
            "const": "ctx.changed",
            "type": "string"
          },
          "entries": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "old_path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "path",
                "old_path"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "in_git_repo": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "in_git_repo",
          "changed_count",
          "entries"
        ],
        "type": "object"
      },
      "secret_slots": [],
      "title": "List changed context paths"
    },
    "domain": "ctx",
    "plugin": "builtin-ctx"
  },
  {
    "descriptor": {
      "description": "Create a compact metadata and symbol digest for files and directories.",
      "effects": {
        "destructive": false,
        "effects": [
          "filesystem_read"
        ],
        "idempotent": true,
        "impact": "Reads metadata and eligible text content under the requested paths; following symlinks may read outside those path trees.",
        "open_world": false,
        "read_only": true,
        "reversibility": "yes",
        "risk": "low"
      },
      "examples": [
        {
          "arguments": {
            "paths": [
              "src",
              "docs"
            ],
            "preset": "review"
          },
          "description": "Pack source and documentation for review"
        }
      ],
      "id": "ctx.pack",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "follow_symlinks": {
            "default": false,
            "description": "Follow symlinked files and directories.",
            "type": "boolean"
          },
          "max_bytes": {
            "default": 8388608,
            "description": "Skip text files larger than this byte size.",
            "minimum": 1,
            "type": "integer"
          },
          "paths": {
            "description": "Files or directories to pack; defaults to the context cwd.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "preset": {
            "default": "review",
            "description": "Controls default limits and symbol density.",
            "enum": [
              "summary",
              "review",
              "debug"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "ctx.pack",
            "type": "string"
          },
          "directory_count": {
            "minimum": 0,
            "type": "integer"
          },
          "file_count": {
            "minimum": 0,
            "type": "integer"
          },
          "item_count": {
            "minimum": 0,
            "type": "integer"
          },
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string"
                },
                "line_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "path": {
                  "type": "string"
                },
                "size_bytes": {
                  "minimum": 0,
                  "type": "integer"
                },
                "symbol_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "symbols": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "line": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "line",
                      "kind",
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "path",
                "kind",
                "size_bytes",
                "line_count",
                "symbol_count",
                "symbols"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "preset": {
            "type": "string"
          },
          "roots": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "skipped_binary_files": {
            "minimum": 0,
            "type": "integer"
          },
          "skipped_large_files": {
            "minimum": 0,
            "type": "integer"
          },
          "skipped_symlink_files": {
            "minimum": 0,
            "type": "integer"
          },
          "symbol_count": {
            "minimum": 0,
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "preset",
          "roots",
          "item_count",
          "file_count",
          "directory_count",
          "symbol_count",
          "skipped_binary_files",
          "skipped_large_files",
          "skipped_symlink_files",
          "truncated",
          "items"
        ],
        "type": "object"
      },
      "secret_slots": [],
      "title": "Pack context metadata"
    },
    "domain": "ctx",
    "plugin": "builtin-ctx"
  },
  {
    "descriptor": {
      "description": "Extract code, configuration, and document symbols from one file or directory.",
      "effects": {
        "destructive": false,
        "effects": [
          "filesystem_read"
        ],
        "idempotent": true,
        "impact": "Reads eligible text files under the requested path; following symlinks may read outside that path tree.",
        "open_world": false,
        "read_only": true,
        "reversibility": "yes",
        "risk": "low"
      },
      "examples": [
        {
          "arguments": {
            "path": "src/commands",
            "preset": "summary"
          },
          "description": "Extract summary symbols from commands"
