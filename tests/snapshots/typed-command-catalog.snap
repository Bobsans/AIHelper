            "type": "string"
          },
          "file_count": {
            "minimum": 0,
            "type": "integer"
          },
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "symbol_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "symbols": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "line": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "line",
                      "kind",
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "path",
                "symbol_count",
                "symbols"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "preset": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "skipped_binary_files": {
            "minimum": 0,
            "type": "integer"
          },
          "skipped_large_files": {
            "minimum": 0,
            "type": "integer"
          },
          "skipped_symlink_files": {
            "minimum": 0,
            "type": "integer"
          },
          "symbol_count": {
            "minimum": 0,
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "preset",
          "root",
          "file_count",
          "symbol_count",
          "skipped_binary_files",
          "skipped_large_files",
          "skipped_symlink_files",
          "truncated",
          "files"
        ],
        "type": "object"
      },
