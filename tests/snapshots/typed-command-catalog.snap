  {
    "descriptor": {
      "description": "Load a named task and execute its command through the platform shell.",
      "effects": {
        "destructive": true,
        "effects": [
          "process_spawn",
          "filesystem_read",
          "filesystem_write",
          "filesystem_delete",
          "network_read",
          "network_write",
          "configuration_read",
          "configuration_write",
          "external_read",
          "external_write"
        ],
        "idempotent": false,
        "impact": "Executes the saved text through PowerShell or sh in context.cwd with the server environment. Shell expansion can run arbitrary programs, read or change files, access networks and external systems, and expose inherited secrets. Timeout or cancellation terminates the process group.",
        "open_world": true,
        "read_only": false,
        "reversibility": "unknown",
        "risk": "critical"
      },
      "examples": [],
      "id": "task.run",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "max_output_bytes": {
            "default": 65536,
            "description": "Maximum captured bytes per output stream.",
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "description": "Task name.",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "timeout_secs": {
            "default": 600,
            "description": "Process timeout capped by the MCP request deadline.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "task.run",
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "task_command": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "name",
          "task_command",
          "exit_code",
          "success",
          "truncated",
          "stdout",
          "stderr"
        ],
        "type": "object"
      },
      "secret_slots": [],
      "title": "Run saved task"
    },
    "domain": "task",
    "plugin": "builtin-task"
  },
  {
    "descriptor": {
      "description": "Create or replace a named shell command in context.cwd/.ah/tasks.json.",
      "effects": {
        "destructive": true,
        "effects": [
          "filesystem_read",
          "filesystem_write",
          "configuration_write"
        ],
        "idempotent": false,
        "impact": "Creates or rewrites context.cwd/.ah/tasks.json and may replace an existing task definition shared by later invocations. The command is stored but not executed.",
        "open_world": false,
        "read_only": false,
        "reversibility": "unknown",
        "risk": "high"
      },
      "examples": [
        {
          "arguments": {
            "command": "cargo test --workspace",
            "name": "test"
          },
          "description": "Save a test task"
        }
      ],
      "id": "task.save",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
