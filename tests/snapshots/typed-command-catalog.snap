        ],
        "idempotent": true,
        "impact": "Reads the requested file; enabling symlink following may read a target outside its apparent path.",
        "open_world": false,
        "read_only": true,
        "reversibility": "yes",
        "risk": "low"
      },
      "examples": [
        {
          "arguments": {
            "from": 1,
            "number_lines": true,
            "path": "src/main.rs",
            "to": 120
          },
          "description": "Read the first 120 numbered lines"
        }
      ],
      "id": "file.read",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "follow_symlinks": {
            "default": false,
            "description": "Allow reading or traversing symlink targets.",
