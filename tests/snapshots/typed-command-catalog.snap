  {
    "descriptor": {
      "description": "Read the first requested number of UTF-8 text lines from a file.",
      "effects": {
        "destructive": false,
        "effects": [
          "filesystem_read"
        ],
        "idempotent": true,
        "impact": "Reads the beginning of the requested file; enabling symlink following may read an external target.",
        "open_world": false,
        "read_only": true,
        "reversibility": "yes",
        "risk": "low"
      },
      "examples": [
        {
          "arguments": {
            "lines": 40,
            "number_lines": true,
            "path": "src/lib.rs"
          },
          "description": "Read the first 40 numbered lines"
        }
      ],
      "id": "file.head",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "follow_symlinks": {
            "default": false,
            "description": "Allow reading or traversing symlink targets.",
            "type": "boolean"
          },
          "lines": {
            "default": 20,
            "description": "Number of lines requested.",
            "minimum": 0,
            "type": "integer"
          },
          "max_bytes": {
            "default": 8388608,
            "description": "Reject a file larger than this byte size.",
            "minimum": 1,
            "type": "integer"
          },
          "number_lines": {
            "default": false,
            "description": "Prefix returned content lines with source line numbers.",
            "type": "boolean"
          },
          "path": {
            "description": "UTF-8 text file to read.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "file.head",
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "from": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "line_count": {
            "minimum": 0,
            "type": "integer"
          },
          "numbered": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "to": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "path",
          "from",
          "to",
          "numbered",
          "line_count",
          "truncated",
          "content"
        ],
        "type": "object"
      },
      "secret_slots": [],
      "title": "Read file head"
    },
    "domain": "file",
    "plugin": "builtin-file"
  },
  {
    "descriptor": {
