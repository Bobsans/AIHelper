  {
    "descriptor": {
      "description": "Run one non-interactive child process, capture bounded output, and return its exit status.",
      "effects": {
        "destructive": true,
        "effects": [
          "process_spawn",
          "filesystem_read",
          "filesystem_write",
          "filesystem_delete",
          "network_read",
          "network_write",
          "configuration_read",
          "configuration_write",
          "external_read",
          "external_write"
        ],
        "idempotent": false,
        "impact": "Executes an arbitrary program in context.cwd with the server environment. The child can read, modify, or delete files, access the network, change external systems, and expose inherited secrets. Stdin is closed; timeout or cancellation terminates its process group.",
        "open_world": true,
        "read_only": false,
        "reversibility": "unknown",
        "risk": "critical"
      },
      "examples": [
        {
          "arguments": {
            "command": [
              "cargo",
              "check"
            ],
            "timeout_secs": 120
          },
          "description": "Run a Rust check"
        }
      ],
      "id": "run.check",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "description": "Program followed by its arguments; no shell parsing is performed.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "max_output_bytes": {
            "default": 65536,
            "description": "Maximum captured bytes for each output stream.",
            "minimum": 1,
            "type": "integer"
          },
          "tail_lines": {
            "description": "Return only the last N captured lines from each stream.",
            "minimum": 0,
            "type": "integer"
          },
          "timeout_secs": {
            "default": 600,
            "description": "Process timeout capped by the MCP request deadline.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "argv": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "command": {
            "const": "run.check",
            "type": "string"
          },
          "duration_ms": {
            "minimum": 0,
            "type": "integer"
          },
          "exit_code": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "stderr": {
            "type": "string"
          },
          "stderr_truncated": {
            "type": "boolean"
          },
          "stdout": {
            "type": "string"
          },
          "stdout_truncated": {
            "type": "boolean"
          },
          "success": {
            "type": "boolean"
          },
          "timed_out": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "argv",
          "success",
          "timed_out",
          "exit_code",
          "duration_ms",
          "stdout",
          "stderr",
          "stdout_truncated",
          "stderr_truncated"
        ],
        "type": "object"
      },
      "secret_slots": [],
      "title": "Run command"
    },
    "domain": "run",
    "plugin": "builtin-run"
  },
  {
