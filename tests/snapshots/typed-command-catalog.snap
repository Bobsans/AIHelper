  {
    "descriptor": {
      "description": "Search literal text or a regular expression across files.",
      "effects": {
        "destructive": false,
        "effects": [
          "filesystem_read"
        ],
        "idempotent": true,
        "impact": "Recursively reads file paths and, for text search, file contents below the selected roots. follow_symlinks=true can traverse linked directories outside those roots; no files are modified.",
        "open_world": false,
        "read_only": true,
        "reversibility": "yes",
        "risk": "medium"
      },
      "examples": [
        {
          "arguments": {
            "globs": [
              "**/*.rs"
            ],
            "paths": [
              "src"
            ],
            "pattern": "TODO"
          },
          "description": "Find TODOs in Rust files"
        }
      ],
      "id": "search.text",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "context_lines": {
            "description": "Context lines before and after each match.",
            "minimum": 0,
            "type": "integer"
          },
          "follow_symlinks": {
            "default": false,
            "description": "Follow symlink directories during traversal.",
            "type": "boolean"
          },
          "globs": {
            "description": "Optional glob filters relative to each search root.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ignore_case": {
            "default": false,
            "description": "Use case-insensitive matching.",
            "type": "boolean"
          },
          "max_bytes": {
            "default": 8388608,
            "description": "Skip files larger than this many bytes.",
            "minimum": 1,
            "type": "integer"
          },
          "paths": {
            "default": [],
            "description": "Files or directories resolved against context.cwd; empty searches context.cwd.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pattern": {
            "description": "Literal text or regular expression to find.",
            "minLength": 1,
            "type": "string"
          },
          "regex": {
            "default": false,
            "description": "Interpret pattern as a regular expression.",
            "type": "boolean"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "backend": {
            "type": "string"
          },
          "command": {
            "const": "search.text",
            "type": "string"
          },
          "context": {
            "minimum": 0,
            "type": "integer"
          },
          "file_count": {
            "minimum": 0,
            "type": "integer"
          },
          "ignore_case": {
            "type": "boolean"
          },
          "match_count": {
            "minimum": 0,
            "type": "integer"
          },
          "matches": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "column": {
                  "minimum": 1,
                  "type": "integer"
                },
                "context_after": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "line": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "line",
                      "text"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "context_before": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "line": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
