          },
          "from": {
            "description": "Inclusive one-based start line.",
            "minimum": 1,
            "type": "integer"
          },
          "max_bytes": {
            "default": 8388608,
            "description": "Reject a file larger than this byte size.",
            "minimum": 1,
            "type": "integer"
          },
          "number_lines": {
            "default": false,
            "description": "Prefix returned content lines with source line numbers.",
            "type": "boolean"
          },
          "path": {
            "description": "UTF-8 text file to read.",
            "minLength": 1,
            "type": "string"
          },
          "to": {
            "description": "Inclusive one-based end line.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "file.read",
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "from": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "line_count": {
            "minimum": 0,
            "type": "integer"
          },
          "numbered": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "to": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "path",
          "from",
          "to",
