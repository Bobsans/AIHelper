    {
      "id": "gitlab.release.create",
      "title": "Create GitLab release",
      "description": "Create a project release with optional description and target reference. Use description or description_file, not both.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
            "description": "REST API base URL. A supplied token is sent to this host.",
            "type": "string"
          },
          "description": {
            "description": "Inline text.",
            "type": "string"
          },
          "description_file": {
            "description": "UTF-8 text file resolved against the execution cwd.",
            "type": "string"
          },
          "graphql_url": {
            "description": "GraphQL API URL used for issue designs.",
            "type": "string"
          },
          "host": {
            "default": "https://gitlab.com",
            "description": "GitLab base URL. Omit it and the host is taken from the git remote, which is why a self-managed instance needs no override. Set it together with project, since naming the project stops the remote from being read.",
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "description": "Release name.",
            "type": "string"
          },
          "project": {
            "description": "Project override as path (group/subgroup/name) or numeric id. Omit it to read the project from the git remote, which also needs context.cwd.",
            "type": "string"
          },
          "ref": {
            "description": "Tag target reference.",
            "type": "string"
          },
          "remote": {
            "default": "origin",
            "minLength": 1,
            "type": "string"
          },
          "tag": {
            "description": "Release tag.",
            "minLength": 1,
            "type": "string"
          },
          "timeout_secs": {
            "default": 60,
            "description": "Per-request HTTP timeout.",
            "minimum": 1,
            "type": "integer"
          },
          "token": {
            "description": "Explicit GitLab token; prefer environment-based authentication.",
            "type": "string"
          },
          "use_git_credential": {
            "default": true,
            "description": "Use Git credential helper lookup as the final fallback.",
            "type": "boolean"
          }
        },
        "required": [
          "tag"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "gitlab.release.create",
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "release": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "command",
          "project",
          "release"
        ],
        "type": "object"
      },
      "effects": {
        "read_only": false,
        "destructive": false,
        "idempotent": false,
        "open_world": true,
        "effects": [
          "network_write",
          "external_write",
          "configuration_read",
          "filesystem_read",
          "process_spawn"
        ],
        "risk": "high",
        "impact": "Creates a persistent release and may create a tag; description files are read from the execution cwd.",
        "reversibility": "unknown"
      },
      "examples": [],
      "secret_slots": [
        {
          "name": "token",
          "accepted_kinds": [
            "gitlab-token"
          ],
          "required": false,
          "description": "GitLab API token."
        }
      ]
    },
    {
