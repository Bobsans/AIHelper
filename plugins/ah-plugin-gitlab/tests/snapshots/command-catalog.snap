    {
      "id": "gitlab.issue.view",
      "title": "View GitLab issue",
      "description": "Return one issue, optionally with comments, designs, and warnings.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
            "description": "REST API base URL. A supplied token is sent to this host.",
