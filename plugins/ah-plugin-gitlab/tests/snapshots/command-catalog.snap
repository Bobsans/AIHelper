{
  "plugin_name": "external-gitlab",
  "domain": "gitlab",
  "commands": [
    {
      "id": "gitlab.project",
      "title": "Inspect GitLab project",
      "description": "Detect the GitLab project and return remote plus API metadata.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
            "description": "REST API base URL. A supplied token is sent to this host.",
            "type": "string"
          },
          "graphql_url": {
            "description": "GraphQL API URL used for issue designs.",
            "type": "string"
          },
          "host": {
            "default": "https://gitlab.com",
            "description": "GitLab base URL. Omit it and the host is taken from the git remote, which is why a self-managed instance needs no override. Set it together with project, since naming the project stops the remote from being read.",
            "minLength": 1,
            "type": "string"
          },
          "project": {
            "description": "Project override as path (group/subgroup/name) or numeric id. Omit it to read the project from the git remote, which also needs context.cwd.",
            "type": "string"
          },
          "remote": {
            "default": "origin",
            "minLength": 1,
            "type": "string"
          },
          "timeout_secs": {
            "default": 60,
            "description": "Per-request HTTP timeout.",
            "minimum": 1,
            "type": "integer"
          },
          "token": {
            "description": "Explicit GitLab token; prefer environment-based authentication.",
            "type": "string"
          },
          "use_git_credential": {
            "default": true,
            "description": "Use Git credential helper lookup as the final fallback.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
            "type": "string"
          },
          "command": {
            "const": "gitlab.project",
            "type": "string"
          },
          "default_branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "type": "string"
          },
          "id": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "path_with_namespace": {
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "type": "string"
          },
          "remote_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "visibility": {
            "type": [
              "string",
              "null"
            ]
          },
          "web_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "api_url",
          "command",
          "default_branch",
          "host",
          "id",
          "path_with_namespace",
          "project",
          "remote_url",
          "visibility",
          "web_url"
        ],
        "type": "object"
      },
      "effects": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": true,
        "effects": [
          "network_read",
          "external_read",
          "configuration_read",
          "process_spawn"
        ],
        "risk": "medium",
        "impact": "May run Git project detection and sends a read request to the configured API URL; a supplied token is sent to that host.",
        "reversibility": "yes"
      },
      "examples": [],
      "secret_slots": [
        {
          "name": "token",
          "accepted_kinds": [
            "gitlab-token"
          ],
          "required": false,
          "description": "GitLab API token."
        }
      ]
    },
    {
      "id": "gitlab.releases",
      "title": "List GitLab releases",
      "description": "List project releases with the shared result limit.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
            "description": "REST API base URL. A supplied token is sent to this host.",
            "type": "string"
          },
          "graphql_url": {
            "description": "GraphQL API URL used for issue designs.",
            "type": "string"
          },
          "host": {
            "default": "https://gitlab.com",
            "description": "GitLab base URL. Omit it and the host is taken from the git remote, which is why a self-managed instance needs no override. Set it together with project, since naming the project stops the remote from being read.",
            "minLength": 1,
            "type": "string"
          },
          "project": {
            "description": "Project override as path (group/subgroup/name) or numeric id. Omit it to read the project from the git remote, which also needs context.cwd.",
            "type": "string"
          },
          "remote": {
            "default": "origin",
            "minLength": 1,
            "type": "string"
          },
          "timeout_secs": {
            "default": 60,
            "description": "Per-request HTTP timeout.",
            "minimum": 1,
            "type": "integer"
          },
          "token": {
            "description": "Explicit GitLab token; prefer environment-based authentication.",
            "type": "string"
          },
          "use_git_credential": {
            "default": true,
            "description": "Use Git credential helper lookup as the final fallback.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "gitlab.releases",
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "release_count": {
            "minimum": 0,
            "type": "integer"
          },
          "releases": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "command",
          "project",
          "release_count",
          "releases"
        ],
        "type": "object"
      },
      "effects": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": true,
        "effects": [
          "network_read",
          "external_read",
          "configuration_read",
          "process_spawn"
        ],
        "risk": "medium",
        "impact": "Reads release metadata and assets from the configured GitLab API.",
        "reversibility": "yes"
      },
      "examples": [],
      "secret_slots": [
        {
          "name": "token",
          "accepted_kinds": [
            "gitlab-token"
          ],
          "required": false,
          "description": "GitLab API token."
        }
      ]
    },
