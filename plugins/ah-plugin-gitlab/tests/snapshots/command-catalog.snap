    {
      "id": "gitlab.job.trace",
      "title": "Read GitLab job trace",
      "description": "Read or filter one job trace.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
            "description": "REST API base URL. A supplied token is sent to this host.",
            "type": "string"
          },
