          },
          "full": {
            "default": false,
            "description": "Also load comments and designs.",
            "type": "boolean"
          },
          "graphql_url": {
            "description": "GraphQL API URL used for issue designs.",
            "type": "string"
          },
          "host": {
            "default": "https://gitlab.com",
            "description": "GitLab base URL. Omit it and the host is taken from the git remote, which is why a self-managed instance needs no override. Set it together with project, since naming the project stops the remote from being read.",
            "minLength": 1,
            "type": "string"
          },
          "iid": {
            "description": "Project issue iid.",
            "minimum": 1,
            "type": "integer"
          },
          "project": {
            "description": "Project override as path (group/subgroup/name) or numeric id. Omit it to read the project from the git remote, which also needs context.cwd.",
            "type": "string"
          },
          "remote": {
            "default": "origin",
            "minLength": 1,
            "type": "string"
          },
          "timeout_secs": {
            "default": 60,
            "description": "Per-request HTTP timeout.",
            "minimum": 1,
            "type": "integer"
          },
          "token": {
            "description": "Explicit GitLab token; prefer environment-based authentication.",
            "type": "string"
          },
          "use_git_credential": {
            "default": true,
            "description": "Use Git credential helper lookup as the final fallback.",
            "type": "boolean"
          }
        },
        "required": [
          "iid"
        ],
        "type": "object"
      },
      "output_schema": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "command": {
                "const": "gitlab.issue.view",
                "type": "string"
              },
              "issue": {
                "additionalProperties": true,
                "type": "object"
              },
              "project": {
                "type": "string"
              }
            },
            "required": [
              "command",
              "project",
              "issue"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "command": {
                "const": "gitlab.issue.view",
                "type": "string"
              },
              "comment_count": {
                "minimum": 0,
                "type": "integer"
              },
              "comments": {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              "design_count": {
                "minimum": 0,
                "type": "integer"
              },
              "designs": {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              "full": {
                "const": true
              },
              "iid": {
                "minimum": 1,
                "type": "integer"
              },
              "issue": {
                "additionalProperties": true,
                "type": "object"
              },
              "project": {
                "type": "string"
              },
              "warnings": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "command",
              "project",
              "iid",
              "full",
              "issue",
              "comment_count",
              "comments",
              "design_count",
              "designs",
              "warnings"
            ],
            "type": "object"
          }
        ],
        "type": "object"
      },
      "effects": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": true,
        "effects": [
          "network_read",
          "external_read",
          "configuration_read",
