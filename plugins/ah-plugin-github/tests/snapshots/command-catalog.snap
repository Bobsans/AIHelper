                  "type": [
                    "string",
                    "null"
                  ]
                },
                "html_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "labels": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "number": {
                  "minimum": 1,
                  "type": "integer"
                },
                "pull_request": {
                  "oneOf": [
                    {
