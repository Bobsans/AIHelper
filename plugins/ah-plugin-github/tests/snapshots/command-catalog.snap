{
  "plugin_name": "external-github",
  "domain": "github",
  "commands": [
    {
      "id": "github.repo",
      "title": "Inspect GitHub repository",
      "description": "Detect the GitHub repository and return remote plus API metadata.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
            "default": "https://api.github.com",
            "description": "GitHub-compatible API base URL. A supplied token is sent to this host.",
            "minLength": 1,
            "type": "string"
          },
          "remote": {
            "default": "origin",
            "minLength": 1,
            "type": "string"
          },
          "repo": {
            "description": "Repository override in OWNER/REPO form. Omit it to read the repository from the git remote, which also needs context.cwd.",
            "type": "string"
          },
          "timeout_secs": {
            "default": 60,
            "description": "Per-request HTTP timeout.",
            "minimum": 1,
            "type": "integer"
          },
          "token": {
            "description": "Explicit GitHub token; prefer environment-based authentication.",
            "type": "string"
          },
          "use_git_credential": {
            "default": true,
            "description": "Use Git credential helper lookup as the final fallback.",
            "type": "boolean"
          }
        },
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
            "type": "string"
          },
          "command": {
            "const": "github.repo",
            "type": "string"
          },
          "default_branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "html_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "private": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "remote_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "repository": {
            "type": "string"
          }
        },
        "required": [
          "api_url",
          "command",
          "default_branch",
          "html_url",
          "name",
          "owner",
          "private",
          "remote_url",
          "repository"
        ],
        "type": "object"
      },
      "effects": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": true,
        "effects": [
          "network_read",
          "external_read",
          "configuration_read",
          "process_spawn"
        ],
        "risk": "medium",
        "impact": "May run Git repository detection and sends a read request to the configured API URL; a supplied token is sent to that host.",
        "reversibility": "yes"
      },
      "examples": [],
      "secret_slots": [
        {
          "name": "token",
          "accepted_kinds": [
            "github-token"
          ],
          "required": false,
          "description": "GitHub API token."
        }
      ]
    },
    {
      "id": "github.issues",
      "title": "List GitHub issues",
      "description": "List or search repository issues with filters and the shared result limit.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "api_url": {
