                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "type": "string"
                },
                "version_major": {
                  "oneOf": [
                    {
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version_raw": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "source",
                "path",
                "psql_path",
                "bin_dir",
                "version_raw",
                "version_major",
                "accepted",
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "command": {
            "const": "postgres.tool.status",
            "type": "string"
          },
          "config_path": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
