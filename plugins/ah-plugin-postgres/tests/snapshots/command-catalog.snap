{
  "plugin_name": "external-postgres",
  "domain": "postgres",
  "commands": [
    {
      "id": "postgres.tool.status",
      "title": "Inspect PostgreSQL toolchain",
      "description": "Resolve psql candidates and report the selected client toolchain.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "tool_path": {
            "description": "Explicit psql executable or tool directory resolved against cwd.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
