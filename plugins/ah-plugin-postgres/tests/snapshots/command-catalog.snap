    {
      "id": "postgres.tool.download",
      "title": "Download PostgreSQL toolchain",
      "description": "Download, verify, and unpack the supported PostgreSQL client toolchain.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "force": {
            "default": false,
            "description": "Replace an existing managed toolchain.",
            "type": "boolean"
          },
          "timeout_secs": {
            "default": 1800,
            "description": "Download timeout capped by the MCP request deadline.",
            "minimum": 1,
            "type": "integer"
          },
          "version": {
            "default": "18.4",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "bin_dir": {
            "type": "string"
          },
          "cache_path": {
            "type": "string"
          },
          "command": {
            "const": "postgres.tool.download",
            "type": "string"
          },
          "downloaded": {
            "type": "boolean"
          },
          "psql_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "version",
          "url",
          "sha256",
          "cache_path",
          "bin_dir",
          "psql_path",
          "downloaded"
        ],
        "type": "object"
      },
      "effects": {
        "read_only": false,
        "destructive": false,
        "idempotent": false,
        "open_world": true,
        "effects": [
          "network_read",
          "filesystem_read",
          "filesystem_write",
          "process_spawn"
        ],
        "risk": "high",
        "impact": "Downloads an executable archive from the built-in vendor URL, verifies its checksum, and writes or replaces files in the shared PostgreSQL tool cache.",
        "reversibility": "yes"
      },
      "examples": [],
      "secret_slots": []
    },
    {
      "id": "postgres.tool.use",
      "title": "Select PostgreSQL toolchain",
      "description": "Validate a psql toolchain path and persist it as the shared default.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Tool executable or directory resolved against cwd.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "postgres.tool.use",
            "type": "string"
          },
          "config_path": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "psql_path": {
            "type": "string"
          },
          "version": {
            "additionalProperties": false,
            "properties": {
              "major": {
                "oneOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "raw": {
                "type": "string"
              }
            },
            "required": [
              "raw",
              "major"
            ],
            "type": "object"
          }
        },
        "required": [
          "command",
          "path",
          "psql_path",
          "version",
          "config_path"
        ],
        "type": "object"
      },
      "effects": {
        "read_only": false,
        "destructive": false,
        "idempotent": true,
        "open_world": false,
        "effects": [
          "filesystem_read",
          "configuration_write",
          "process_spawn"
        ],
        "risk": "high",
        "impact": "Executes the selected psql binary with --version and changes the shared PostgreSQL tool configuration used by later tasks.",
        "reversibility": "yes"
      },
      "examples": [],
      "secret_slots": []
    },
    {
      "id": "postgres.tool.cleanup",
      "title": "Clean PostgreSQL tool cache",
      "description": "Delete one version or all versions from the managed PostgreSQL tool cache.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "description": "Managed version to remove; omit to remove every cached version.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "postgres.tool.cleanup",
            "type": "string"
          },
          "removed": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "command",
          "removed"
        ],
        "type": "object"
      },
      "effects": {
        "read_only": false,
        "destructive": true,
        "idempotent": true,
        "open_world": false,
        "effects": [
          "filesystem_delete"
        ],
        "risk": "high",
        "impact": "Permanently deletes managed PostgreSQL tool directories from the shared cache; concurrent tasks using those binaries may fail.",
        "reversibility": "no"
      },
      "examples": [],
      "secret_slots": []
    },
    {
      "id": "postgres.ping",
      "title": "Ping PostgreSQL",
      "description": "Connect and return server plus session identity metadata.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "connect_timeout_secs": {
            "default": 10,
            "description": "Connection timeout capped by the MCP request deadline.",
            "minimum": 1,
            "type": "integer"
          },
          "database": {
            "description": "PostgreSQL database name.",
            "type": "string"
          },
          "ensure_tool": {
            "default": false,
            "description": "Download the managed toolchain when no usable psql exists. This writes the shared cache.",
            "type": "boolean"
          },
          "host": {
            "description": "PostgreSQL host.",
            "type": "string"
          },
          "password_env": {
            "description": "For password-protected servers, name an environment variable that already exists in this process; its value is passed to psql as PGPASSWORD. Never pass the password itself, and never guess a variable name. Prefer the database credential slot: call secrets.list with kind=postgres, and if no secret matches, ask the user to create one instead.",
            "type": "string"
          },
          "port": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "service": {
            "description": "libpq service name.",
            "type": "string"
          },
          "sslmode": {
            "enum": [
              "disable",
              "allow",
              "prefer",
              "require",
              "verify-ca",
              "verify-full"
            ],
            "type": "string"
          },
          "statement_timeout_ms": {
            "description": "Server statement timeout capped by the MCP request deadline.",
            "minimum": 1,
            "type": "integer"
          },
          "tool_path": {
            "description": "Explicit psql executable or tool directory resolved against cwd.",
            "type": "string"
          },
          "user": {
            "description": "PostgreSQL user.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "postgres.ping",
            "type": "string"
          },
          "current_database": {
            "type": "string"
          },
          "current_schema": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "current_user": {
            "type": "string"
          },
          "inet_server_addr": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "inet_server_port": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "server_encoding": {
            "type": "string"
          },
          "server_version": {
            "type": "string"
          },
          "session_user": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "server_version",
          "current_database",
          "current_user",
          "session_user",
          "current_schema",
          "server_encoding",
          "inet_server_addr",
          "inet_server_port"
        ],
        "type": "object"
      },
      "effects": {
        "read_only": false,
        "destructive": false,
        "idempotent": false,
        "open_world": true,
        "effects": [
          "filesystem_read",
          "filesystem_write",
          "configuration_read",
          "process_spawn",
          "network_read",
          "external_read"
        ],
        "risk": "high",
        "impact": "Reads server/session metadata. ensure_tool=true may first download and write a shared client toolchain. Runs psql as a child process. ensure_tool=true may download and write a shared client toolchain before connecting.",
        "reversibility": "yes"
      },
      "examples": [],
      "secret_slots": [
        {
          "name": "database",
          "accepted_kinds": [
            "postgres"
          ],
          "required": false,
          "description": "PostgreSQL database credential."
        }
      ]
    },
