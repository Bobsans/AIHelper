                "accepted": {
                  "type": "boolean"
                },
                "bin_dir": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path": {
                  "type": "string"
                },
